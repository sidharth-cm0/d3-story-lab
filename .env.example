# D3 Story Lab - Environment Configuration
# Copy this file to .env and replace placeholders with your credentials

# Hugging Face Inference API / ZeroGPU Token for On-Demand Storyboard Generation
# Get a free token at https://huggingface.co/settings/tokens (Read permissions are sufficient)
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN

# Model selection for On-Demand Storyboard (default: SDXL Base 1.0)
ON_DEMAND_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Storyboard render provider: "on_demand" (default) or "comfyui"
STORYBOARD_RENDER_PROVIDER=on_demand

# Optional: Dedicated ComfyUI endpoint (only required if using local/remote ComfyUI runtime)
# STORYBOARD_RUNTIME_URL=http://127.0.0.1:8188
